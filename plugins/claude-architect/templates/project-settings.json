{
  "extraKnownMarketplaces": {
    "paul-claude-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/wfbcargo/PaulClaudePlugins.git"
      }
    }
  },
  "enabledPlugins": {
    "claude-architect@paul-claude-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-install.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(.env*)",
      "Read(.env*)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
